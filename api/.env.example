# Copie este arquivo para .env e preencha os valores.
# O .env nunca vai para o git (está no .gitignore).

# Ambiente: development | production | test
NODE_ENV=development

# Porta da API (o Render define a dele sozinho)
PORT=3333

# Conexão com o PostgreSQL.
# Local (Docker):  postgresql://codeguilds:codeguilds@localhost:5433/codeguilds
# Neon (produção): postgresql://usuario:senha@host.neon.tech/codeguilds?sslmode=require
DATABASE_URL=postgresql://codeguilds:codeguilds@localhost:5433/codeguilds

# Arquivos das entregas (fase 5)
# local    = numa pasta da API (UPLOADS_DIR), bom pra desenvolvimento
# supabase = no Supabase Storage (produção)
STORAGE_DRIVER=local
UPLOADS_DIR=uploads

# Só com STORAGE_DRIVER=supabase (veja "Arquivos no Supabase Storage" no README)
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=chave-secreta-service-role
# SUPABASE_ANON_KEY=chave-publica-anon
# SUPABASE_BUCKET=entregas

# Primeiro ADM da plataforma, criado pelo comando npm run seed
ADMIN_NAME=Danilo
ADMIN_EMAIL=seu-email@exemplo.com
ADMIN_PASSWORD=troque-esta-senha
