{
  "name": "codeguilds-api",
  "version": "1.0.0",
  "description": "API da plataforma CodeGuilds",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsup src/server.ts --out-dir build",
    "start": "node build/server.js",
    "typecheck": "tsc --noEmit",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "migrate": "kysely migrate:latest --no-outdated-check",
    "migrate:make": "kysely migrate:make --no-outdated-check",
    "migrate:down": "kysely migrate:down --no-outdated-check",
    "migrate:reset": "kysely migrate:rollback --all --no-outdated-check",
    "seed": "kysely seed:run --no-outdated-check",
    "db:types": "kysely-codegen --camel-case --out-file src/types/database.ts"
  },
  "keywords": [],
  "author": "Danilo Amaral",
  "license": "ISC",
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/rate-limit": "^11.2.0",
    "@node-rs/argon2": "^2.2.1",
    "dotenv": "^18.0.4",
    "fastify": "^5.12.5",
    "kysely": "^0.28.17",
    "pg": "^8.23.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/pg": "^8.23.1",
    "kysely-codegen": "^0.20.0",
    "kysely-ctl": "^0.21.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
